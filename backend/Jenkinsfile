pipeline {

    agent any

    options {
        skipDefaultCheckout(true)
    }

    tools {
        jdk 'jdk21'
        maven 'maven3'
    }

    environment {
        SERVICE_DIRECTORY = 'backend/ioi-service'
        SONAR_PROJECT_KEY = 'BondTradeX-IOI-Service'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build, Test & JaCoCo') {
            steps {
                dir("${SERVICE_DIRECTORY}") {

                    /*
                     * mvn clean verify:
                     * - compiles the application
                     * - runs tests
                     * - packages the JAR
                     * - generates the JaCoCo report
                     * - executes the configured JaCoCo coverage check
                     */
                    bat 'mvn clean verify'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir("${SERVICE_DIRECTORY}") {

                    withSonarQubeEnv('sonarqube') {

                        bat '''
                        mvn sonar:sonar ^
                          "-Dsonar.projectKey=%SONAR_PROJECT_KEY%" ^
                          "-Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml"
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {

                timeout(time: 10, unit: 'MINUTES') {

                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }

    post {

        always {

            junit(
                allowEmptyResults: true,
                testResults: 'backend/ioi-service/target/surefire-reports/*.xml'
            )

            archiveArtifacts(
                artifacts: 'backend/ioi-service/target/*.jar',
                allowEmptyArchive: true
            )

            archiveArtifacts(
                artifacts: 'backend/ioi-service/target/site/jacoco/**',
                allowEmptyArchive: true
            )
        }

        success {
            echo 'BondTradeX IOI CI pipeline completed successfully.'
        }

        failure {
            echo 'BondTradeX IOI CI pipeline failed. Check the failed stage above.'
        }
    }
}